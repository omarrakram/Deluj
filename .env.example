# ─────────────────────────────────────────────────────────────────────────────
# DELUJ Digital Operating System — environment
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (shared realtime state across devices — required for the deployed demo).
# Without these the app runs on the built-in in-memory server, which syncs every
# device connected to ONE running server (perfect for a laptop + hotspot backup).
NEXT_PUBLIC_SUPABASE_URL=
# The project's anon / publishable key. Safe in the browser: it can only READ demo
# rows (enforced by Row Level Security). All writes go through the Next.js server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes to write orders, requests and menu changes.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the public URL encoded in the Table 07 QR card.
# Defaults to whatever domain the print page is opened on.
NEXT_PUBLIC_SITE_URL=

# Optional: protect /staff and /owner (and their write APIs) with a shared code.
# Leave empty for a frictionless meeting demo.
DELUJ_ACCESS_CODE=
