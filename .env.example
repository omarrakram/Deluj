# ─────────────────────────────────────────────────────────────────────────────
# DELUJ Digital Operating System — environment
# Local: copy to .env.local. Vercel: Project → Settings → Environment Variables
# (tick Production AND Preview). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase — REQUIRED for the deployed multi-device demo ───────────────────
# Supabase → Project Settings → API Keys. Without all three, the app falls back to
# its in-memory server (fine on one laptop; on Vercel /api/health reports 503).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "Publishable" key (sb_publishable_…) or legacy "anon public" key. Safe in
# the browser: Row Level Security lets it READ demo rows only.
# (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alias.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. The "Secret" key (sb_secret_…) or legacy "service_role" key.
# Never prefix with NEXT_PUBLIC_. (SUPABASE_SECRET_KEY is accepted as an alias.)
SUPABASE_SERVICE_ROLE_KEY=

# ── Recommended ──────────────────────────────────────────────────────────────
# A short code that protects /staff, /owner and their actions (Reset Demo,
# kitchen moves, menu edits). Guests ordering from the QR never need it.
# Enter it once on the iPad and the laptop; it is remembered for 30 days.
DELUJ_ACCESS_CODE=

# ── Optional ─────────────────────────────────────────────────────────────────
# The public URL encoded in the Table QR cards. Not needed on Vercel: the QR
# automatically uses the project's public production domain. Set it only for a
# custom domain, e.g. https://order.deluj.com
NEXT_PUBLIC_SITE_URL=

# Force the in-memory backend even when Supabase is configured (LAN backup).
# DELUJ_BACKEND=memory
